// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL") // pooled (port 6543) — used at runtime
  directUrl  = env("DIRECT_URL") // direct (port 5432) — used by `prisma migrate` only
  extensions = [vector]
}

enum Platform {
  instagram
  tiktok
}

// Shared/global cache row: one per unique Instagram Reel or TikTok video,
// regardless of how many users have saved it. See SavedRecipe for per-user
// ownership.
model Recipe {
  id                  String        @id @default(cuid())
  title               String
  category            String
  ingredients         String // Will store JSON string
  instructions        String // Will store JSON string
  illustration        String? // full-size WebP, used for the recipe hero
  // Smaller WebP variant for grid/card thumbnails — avoids shipping the
  // full-size hero image into a tiny card slot. Null for recipes created
  // before this field existed or still on the raw source thumbnail.
  illustrationThumb   String?
  // True while illustration generation is still running in the background
  // (see server/routes/recipes.ts) — persisted so a page reload or a
  // different route into this recipe still knows to retry/poll for it,
  // instead of leaving it stuck on the source thumbnail forever.
  illustrationPending Boolean       @default(false)
  // Null for recipes with no captured source (e.g. the photo/OCR upload path).
  platform            Platform?
  url                 String?       @unique
  // Freeform provenance for recipes with no platform/creator (e.g. "Ottolenghi
  // – Simple"), captured for attribution and rights-holder takedown requests —
  // set only via the photo/OCR upload path today. Always null for
  // platform-sourced recipes, which get attribution from creator/url instead.
  source              String?
  videoUrl            String?
  prepTime            String?
  cookTime            String?
  totalTime           String?
  servings            Int           @default(4)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  savedRecipes        SavedRecipe[]
  creatorId           String?
  creator             Creator?      @relation(fields: [creatorId], references: [id])
  // Supabase user id of whoever triggered the scrape+AI pipeline that created
  // this row (see POST /api/recipes/from-url) — null for anonymous imports.
  // Distinct from SavedRecipe.userId: that tracks who has this recipe in
  // their own list, not who paid for the AI work that produced it.
  createdByUserId     String?
  // Semantic-search vector over title+category+ingredients+instructions
  // (OpenAI text-embedding-3-small, 1536 dims). Null until the background
  // embed step (or the backfill script) fills it in — see
  // server/lib/embeddings.ts. Prisma can't type pgvector columns, so this is
  // never read/written through the normal client, only via $queryRaw/$executeRaw.
  embedding           Unsupported("vector(1536)")?

  @@index([creatorId])
  @@index([createdByUserId])
}

// The Instagram or TikTok account a recipe was scraped from. Nullable link
// from Recipe because recipes created via the photo/OCR upload path (see
// server/routes/ai.ts performOCR) have no social source at all. "claimed"
// tracks whether the creator has taken ownership of their public hub page —
// see /createurs/:platform/:handle — not whether they consented to being
// listed at all (that's handled editorially, outside this model, for now).
model Creator {
  id                     String    @id @default(cuid())
  platform               Platform  @default(instagram)
  handle                 String
  displayName            String?
  avatarUrl              String?
  bio                    String?
  claimed                Boolean   @default(false)
  claimedByUserId        String?
  // Pending claim state: a code the requesting user must post in their
  // Instagram/TikTok bio before `claimed`/`claimedByUserId` above are set.
  // Kept separate from the confirmed fields so an abandoned/failed attempt
  // never reads as claimed.
  claimVerificationCode  String?
  claimRequestedByUserId String?
  claimRequestedAt       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  recipes                Recipe[]

  @@unique([platform, handle])
}

model SavedRecipe {
  id                String             @id @default(cuid())
  userId            String
  recipeId          String
  recipe            Recipe             @relation(fields: [recipeId], references: [id])
  savedAt           DateTime           @default(now())
  reactions         Reaction[]
  platingChallenges PlatingChallenge[]

  @@unique([userId, recipeId])
  @@index([userId])
}

// A Slack-style emoji reaction on a specific SavedRecipe "card", scoped to
// the (SavedRecipe, Household) pair rather than just the SavedRecipe — a
// user can belong to several bandes, so the same saved recipe can appear in
// more than one bande's feed at once, and reactions must not bleed from one
// bande into another (e.g. a "copains" reaction showing up to "famille").
model Reaction {
  id            String      @id @default(cuid())
  savedRecipeId String
  savedRecipe   SavedRecipe @relation(fields: [savedRecipeId], references: [id], onDelete: Cascade)
  householdId   String
  household     Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId        String
  emoji         String
  createdAt     DateTime    @default(now())

  @@unique([savedRecipeId, householdId, userId, emoji])
  @@index([savedRecipeId, householdId])
}

// A small group of users (e.g. a family, or a friend group) who can see
// each other's saved recipes — see HouseholdMember for membership and
// server/routes/recipes.ts (GET /household/:id) for the shared feed. A user
// can belong to several households at once (e.g. one with family, one with
// friends); joined via a short, shareable inviteCode rather than an
// email-based invite flow.
model Household {
  id                String             @id @default(cuid())
  name              String?
  inviteCode        String             @unique
  createdAt         DateTime           @default(now())
  members           HouseholdMember[]
  reactions         Reaction[]
  platingChallenges PlatingChallenge[]
}

// One row per (household, user) pair. A user can belong to multiple
// households, so userId is only unique per household, not globally — see
// Household's doc comment. There's no local Users table; userId is the
// Supabase auth id.
model HouseholdMember {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  joinedAt    DateTime  @default(now())

  @@unique([householdId, userId])
  @@index([userId])
}

// One row per browser/device Web Push subscription for a user — a user can
// have several (phone + desktop). endpoint is unique per subscription and is
// how the browser identifies it; p256dh/auth are the keys web-push needs to
// encrypt the notification payload (see server/lib/webPush.ts). No relation
// to a Users table since there isn't one — userId is the Supabase auth id,
// same convention as HouseholdMember.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Throttles the expensive path (Instagram fetch + AI) for anonymous callers
// only — cache hits and authenticated users are never rate-limited here.
model AnonymousProcessingLog {
  id        String   @id @default(cuid())
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

// One row per OpenAI call — powers the /admin usage dashboard. `action`
// identifies the call site (see server/lib/aiUsageLog.ts), not the model.
// costUsd is computed and frozen at write time from server/lib/aiPricing.ts,
// so it reflects the rate that actually applied then, even if rates change later.
model AiUsageLog {
  id               String   @id @default(cuid())
  action           String
  model            String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  audioSeconds     Float?
  imageCount       Int?
  costUsd          Float    @default(0)
  // Supabase user id, when the triggering request was authenticated — null
  // for anonymous callers (rate-limited separately, see AnonymousProcessingLog).
  userId           String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// Per-user merged shopping list line. Rows are keyed by (userId, name, unit) so
// that adding "200 g de farine" from one recipe and "1 kg de farine" from
// another merges into a single row with a stable id — checked state survives
// further merges. unit is never null: Postgres treats two NULLs as distinct in
// a unique constraint, so an absent/incompatible unit is normalized to ''
// instead (see server/lib/unitConversion.ts).
model ShoppingListItem {
  id              String   @id @default(cuid())
  userId          String
  name            String
  unit            String
  quantity        Float?
  label           String
  // Supermarket aisle (see server/lib/ingredientCategory.ts), derived from
  // name at merge time and stored so the list can group/order by it without
  // recomputing on every read.
  category        String   @default("Autre")
  checked         Boolean  @default(false)
  sourceRecipeIds String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, name, unit])
  @@index([userId])
}

// Lets a shopping list be worked on together with one other bande member —
// the owner picks exactly one co-member to share with (see
// resolveListOwnerId in server/routes/shoppingList.ts, which redirects the
// recipient's list reads/writes to the owner's items). ownerUserId is unique
// since a list can only be shared with one person at a time; by default (no
// row here) a list is private to its owner.
model ShoppingListShare {
  id               String   @id @default(cuid())
  ownerUserId      String   @unique
  sharedWithUserId String
  createdAt        DateTime @default(now())

  @@index([sharedWithUserId])
}

// "Laser Croq" — a gamified plating ("dressage") challenge inside one
// specific bande: members photograph their own version of a dish and the
// bande crowns a winner via PlatingVote. Not required to be based on a
// saved recipe (see savedRecipeId) — a challenge can just be a freeform
// theme like "Dressage du dimanche" with no recipe attached at all.
model PlatingChallenge {
  id              String              @id @default(cuid())
  householdId     String
  household       Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  title           String
  savedRecipeId   String?
  savedRecipe     SavedRecipe?        @relation(fields: [savedRecipeId], references: [id], onDelete: SetNull)
  createdByUserId String
  endsAt          DateTime
  createdAt       DateTime            @default(now())
  submissions     PlatingSubmission[]

  @@index([householdId])
  @@index([savedRecipeId])
}

// One member's photographed dressage for a challenge — one per (challenge,
// user); resubmitting replaces the existing photo/caption rather than
// adding a second entry, so the feed never shows the same cook twice for
// the same challenge.
model PlatingSubmission {
  id            String           @id @default(cuid())
  challengeId   String
  challenge     PlatingChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId        String
  photoUrl      String
  photoThumbUrl String
  caption       String?
  createdAt     DateTime         @default(now())
  votes         PlatingVote[]
  comments      PlatingComment[]
  reactions     PlatingReaction[]

  @@unique([challengeId, userId])
  @@index([challengeId])
}

// A "crown" vote for best dressage — toggle semantics like Reaction, one
// vote per (submission, voter). A voter can crown more than one submission.
model PlatingVote {
  id           String            @id @default(cuid())
  submissionId String
  submission   PlatingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime          @default(now())

  @@unique([submissionId, userId])
  @@index([submissionId])
}

// Freeform banter on a dressage submission — the running commentary a
// bande uses to roast/compliment each other's plating.
model PlatingComment {
  id           String            @id @default(cuid())
  submissionId String
  submission   PlatingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  body         String
  createdAt    DateTime          @default(now())

  @@index([submissionId])
}

// A fun, purely-expressive reaction on a dressage submission — distinct
// from PlatingVote (the one "best dressage" crown): everyone in the bande
// can drop as many of the 7 curated types as they like on the same photo
// (toggle per type, like Reaction on SavedRecipe), and the client replays
// them all as an animated burst whenever the card comes into view — see
// ALLOWED_PLATING_REACTIONS in server/routes/platingChallenges.ts.
model PlatingReaction {
  id           String            @id @default(cuid())
  submissionId String
  submission   PlatingSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  type         String
  createdAt    DateTime          @default(now())

  @@unique([submissionId, userId, type])
  @@index([submissionId])
}
